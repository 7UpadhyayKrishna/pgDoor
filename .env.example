# Local Docker: postgresql://pgdoor:pgdoor@localhost:5432/pgdoor
# Local Homebrew may use port 55432 if 5432 is taken.
# Supabase: use pooler :6543 for DATABASE_URL and direct :5432 for DIRECT_URL
DATABASE_URL="postgresql://pgdoor:pgdoor@localhost:5432/pgdoor"
DIRECT_URL="postgresql://pgdoor:pgdoor@localhost:5432/pgdoor"
SESSION_SECRET="change-me-to-a-long-random-string"
# "dev" logs the code and accepts OTP_BYPASS_CODE (ignored when VERCEL_ENV=production).
# "msg91" sends real SMS; needs a DLT-approved OTP template.
OTP_BYPASS_CODE="123456"
OTP_PROVIDER="dev"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
# Supabase Storage for listing photos. Create a *public* bucket (default name "pg-photos").
# The service role key is server-only; never expose it with a NEXT_PUBLIC_ prefix.
# Leave empty in local dev to store uploads under public/uploads instead.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="pg-photos"
# Server key: Places API (New), Routes API, Maps Embed API, Maps Static API
# (the embed iframe on listing pages exposes this key, so restrict it by API, not by IP)
GOOGLE_MAPS_API_KEY=""
# "true" uses the keyed Maps Embed API on listing pages (needs billing); otherwise the keyless embed is used.
GOOGLE_MAPS_EMBED_API="false"
# Browser key (HTTP-referrer-restricted): Maps JavaScript API (+ Marker library)
# Both keys can be the same for local dev.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# "true" hides the seeker marketplace and shows the owner "List your PG" landing page.
# Set to "false" (and redeploy) on launch day.
NEXT_PUBLIC_PRELAUNCH="true"
