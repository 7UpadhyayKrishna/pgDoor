generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SEEKER
  OWNER
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum VerificationLevel {
  UNVERIFIED
  OWNER_VERIFIED
  PROPERTY_VERIFIED
  PGDOOR_VERIFIED
}

enum OwnerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PgType {
  BOYS
  GIRLS
  CO_LIVING
  UNISEX
}

enum PreferredTenants {
  ANY
  STUDENTS
  PROFESSIONALS
}

enum RoomSharingType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum AmenityGroup {
  ROOM
  PROPERTY
  SERVICES
}

enum LeadMoveInWindow {
  IMMEDIATE
  WITHIN_7_DAYS
  THIS_MONTH
  LATER
}

enum LeadIntentScore {
  HIGH
  MEDIUM
  LOW
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  CLOSED
}

enum LeadEventType {
  WHATSAPP_CLICK
  CALL_CLICK
  ENQUIRY
  VISIT_REQUEST
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReportReason {
  WRONG_PRICE
  NOT_AVAILABLE
  FAKE_PHOTOS
  WRONG_LOCATION
  OWNER_ISSUE
  DUPLICATE_LISTING
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum VerificationCheckType {
  PROPERTY
  OWNER
  PHOTOS
  ADDRESS
  AMENITIES
  PRICING
  AVAILABILITY
}

enum CheckStatus {
  PENDING
  PASSED
  FAILED
  NOT_APPLICABLE
}

enum ProspectSource {
  FIELD_VISIT
  REFERRAL
  INBOUND
  CALL
  OTHER
}

enum ProspectStage {
  NEW
  CONTACTED
  INTERESTED
  VISIT_SCHEDULED
  LISTED
  ONBOARDED
  LOST
}

enum ProspectActivityType {
  NOTE
  CALL
  WHATSAPP
  VISIT
  STAGE_CHANGE
  FOLLOW_UP
}

enum LandmarkType {
  METRO
  COLLEGE
  OFFICE
  RESTAURANT
  HOSPITAL
  GROCERY
  OTHER
}

enum DestinationType {
  COLLEGE
  OFFICE
  COACHING
  LIBRARY
  METRO
  CUSTOM
}

enum CommuteMode {
  walk
  cycle
  metro
  rapid_metro
  bus
  auto
  shared_auto
  rapido
  cab
  own_vehicle
}

enum CommuteSlot {
  peak
  offpeak
}

enum CommuteSource {
  google
  fare_table
  estimate
}

enum PoiCategory {
  FOOD
  GROCERY
  METRO
  BUS_STOP
  HOSPITAL
  PHARMACY
  GYM
  LAUNDRY
  CAFE
  ATM
  PARK
  LIBRARY
  POLICE
}

enum NotificationChannel {
  IN_APP
  PUSH
  WHATSAPP
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogSchemaType {
  BLOG_POSTING
  ARTICLE
  HOW_TO
  NEWS_ARTICLE
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  phone              String    @unique
  email              String?   @unique
  role               UserRole  @default(SEEKER)
  phoneVerified      Boolean   @default(false)
  blocked            Boolean   @default(false)
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ownerProfile        OwnerProfile?
  leads               Lead[]
  savedProperties     SavedProperty[]
  reviews             Review[]
  reports             Report[]
  sessions            Session[]
  otpCodes            OtpCode[]
  auditLogs           AuditLog[]
  leadEvents          LeadEvent[]
  chatMessages        ChatMessage[]
  searches            UserSearch[]
  alerts              Alert[]
  availabilityWatches AvailabilityWatch[]
  blogAuthor          BlogAuthor?
  roommateProfile     RoommateProfile?
  roommateMatchesA    RoommateMatch[]     @relation("RoommateA")
  roommateMatchesB    RoommateMatch[]     @relation("RoommateB")
  checksDone          VerificationCheck[] @relation("VerificationChecker")
  assignedProspects   OwnerProspect[]     @relation("ProspectAssignee")
  prospectActivities  ProspectActivity[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  phone      String
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
}

model OwnerProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  businessName       String?
  verificationStatus OwnerVerificationStatus @default(UNVERIFIED)
  createdByAdminId   String?
  credentialIssuedAt DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  leads      Lead[]
  prospects  OwnerProspect[]
}

model City {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  state     String
  isActive  Boolean @default(true)
  latitude  Float?
  longitude Float?

  areas        Area[]
  landmarks    Landmark[]
  properties   Property[]
  destinations Destination[]
  prospects    OwnerProspect[]
  blogPosts    BlogPost[]
}

model Area {
  id        String @id @default(cuid())
  cityId    String
  name      String
  slug      String
  latitude  Float?
  longitude Float?

  city       City            @relation(fields: [cityId], references: [id])
  properties Property[]
  landmarks  Landmark[]
  prospects  OwnerProspect[]
  blogPosts  BlogPost[]

  @@unique([cityId, slug])
}

model Landmark {
  id        String       @id @default(cuid())
  cityId    String
  areaId    String?
  name      String
  slug      String
  type      LandmarkType
  latitude  Float
  longitude Float?

  city City  @relation(fields: [cityId], references: [id])
  area Area? @relation(fields: [areaId], references: [id])

  @@unique([cityId, slug])
}

model Property {
  id                      String            @id @default(cuid())
  ownerId                 String
  name                    String
  slug                    String            @unique
  description             String?           @db.Text
  address                 String
  cityId                  String
  areaId                  String
  latitude                Float
  longitude               Float
  h3Cell                  String?
  livabilityScore         Float?
  livabilityBreakdown     Json?
  safetyScore             Float?
  safetyBreakdown         Json?
  commuteBadges           String[]          @default([])
  tourVideoUrl            String?
  tourThumbnailUrl        String?
  pgType                  PgType
  status                  PropertyStatus    @default(PENDING_REVIEW)
  verificationLevel       VerificationLevel @default(UNVERIFIED)
  featured                Boolean           @default(false)
  minRent                 Int               @default(0)
  /// Null when no room has a known deposit ("Ask owner"), never a stand-in 0.
  minDeposit              Int?
  availableBeds           Int               @default(0)
  totalBeds               Int               @default(0)
  foodIncluded            Boolean           @default(false)
  maintenanceCharge       Int?
  electricityNote         String?
  vegetarianFood          Boolean           @default(false)
  nonVegetarianFood       Boolean           @default(false)
  smokingAllowed          Boolean           @default(false)
  visitorsAllowed         Boolean           @default(false)
  cookingAllowed          Boolean           @default(false)
  alcoholAllowed          Boolean           @default(false)
  mealsProvided           String[]          @default([])
  gateClosingTime         String?
  noticePeriodDays        Int?
  lockInMonths            Int?
  preferredTenants        PreferredTenants  @default(ANY)
  contactName             String?
  contactPhone            String?
  otherAmenities          String?           @db.Text
  ratingAvg               Float             @default(0)
  reviewCount             Int               @default(0)
  viewCount               Int               @default(0)
  availabilityUpdatedAt   DateTime          @default(now())
  availabilityConfirmedAt DateTime          @default(now())
  moveInFrom              DateTime?
  verifiedAt              DateTime?
  publishedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  owner                 OwnerProfile           @relation(fields: [ownerId], references: [id])
  city                  City                   @relation(fields: [cityId], references: [id])
  area                  Area                   @relation(fields: [areaId], references: [id])
  roomTypes             RoomType[]
  rooms                 Room[]
  photos                Photo[]
  amenities             PropertyAmenity[]
  leads                 Lead[]
  reviews               Review[]
  reports               Report[]
  savedBy               SavedProperty[]
  verificationChecks    VerificationCheck[]
  availabilityReminders AvailabilityReminder[]
  leadEvents            LeadEvent[]
  commuteEdges          CommuteEdge[]
  propertyPois          PropertyPoi[]
  availabilityWatches   AvailabilityWatch[]
  slugRedirects         PropertySlugRedirect[]

  @@index([cityId, status])
  @@index([areaId, status])
  @@index([status, featured, minRent])
  @@index([availableBeds])
  @@index([h3Cell])
  @@index([latitude, longitude])
}

/// A tenant asked to be told when a full PG has a free bed again.
model AvailabilityWatch {
  id         String    @id @default(cuid())
  userId     String
  propertyId String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId, notifiedAt])
}

/// Old slugs keep resolving (301) after a listing is renamed or re-pinned.
model PropertySlugRedirect {
  slug       String   @id
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model RoomType {
  id            String          @id @default(cuid())
  propertyId    String
  sharingType   RoomSharingType
  rent          Int
  /// Null = owner hasn't told us; 0 = confirmed zero deposit.
  deposit       Int?
  totalBeds     Int
  availableBeds Int
  rooms         Room[]
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, sharingType])
}

model Room {
  id         String   @id @default(cuid())
  propertyId String
  roomTypeId String
  name       String
  totalBeds  Int
  beds       Bed[]
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
}

model Bed {
  id     String    @id @default(cuid())
  roomId String
  label  String
  status BedStatus @default(AVAILABLE)
  room   Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Amenity {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  group      AmenityGroup
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Photo {
  id           String   @id @default(cuid())
  propertyId   String
  url          String
  thumbnailUrl String?
  alt          String?
  sortOrder    Int      @default(0)
  width        Int?
  height       Int?
  mimeType     String?
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Lead {
  id             String           @id @default(cuid())
  seekerId       String
  propertyId     String
  ownerId        String
  moveInWindow   LeadMoveInWindow
  roomPreference RoomSharingType?
  budget         Int?
  phoneVerified  Boolean          @default(false)
  intentScore    LeadIntentScore  @default(MEDIUM)
  status         LeadStatus       @default(NEW)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  seeker   User          @relation(fields: [seekerId], references: [id])
  property Property      @relation(fields: [propertyId], references: [id])
  owner    OwnerProfile  @relation(fields: [ownerId], references: [id])
  visits   Visit[]
  events   LeadEvent[]
  messages ChatMessage[]

  @@index([ownerId, status])
  @@index([propertyId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  leadId    String
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Visit {
  id          String      @id @default(cuid())
  leadId      String
  scheduledAt DateTime
  status      VisitStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime    @default(now())
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadEvent {
  id         String        @id @default(cuid())
  leadId     String?
  propertyId String
  userId     String?
  type       LeadEventType
  metadata   Json?
  createdAt  DateTime      @default(now())

  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([propertyId, type])
}

model Review {
  id           String       @id @default(cuid())
  userId       String
  propertyId   String
  overall      Float
  comment      String?      @db.Text
  verifiedStay Boolean      @default(false)
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  scores       ReviewScore?

  @@unique([userId, propertyId])
}

model ReviewScore {
  id          String @id @default(cuid())
  reviewId    String @unique
  cleanliness Float
  food        Float
  location    Float
  management  Float
  value       Float
  commute     Float  @default(0)
  safety      Float  @default(0)
  owner       Float  @default(0)
  review      Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model SavedProperty {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model Report {
  id         String       @id @default(cuid())
  userId     String?
  propertyId String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id])
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model VerificationCheck {
  id           String                @id @default(cuid())
  propertyId   String
  type         VerificationCheckType
  passed       Boolean               @default(false)
  status       CheckStatus           @default(PENDING)
  notes        String?               @db.Text
  evidenceUrls String[]              @default([])
  checkedById  String?
  checkedAt    DateTime?
  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  checkedBy    User?                 @relation("VerificationChecker", fields: [checkedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, type])
}

model OwnerProspect {
  id             String         @id @default(cuid())
  name           String
  phone          String
  businessName   String?
  pgName         String?
  cityId         String?
  areaId         String?
  address        String?
  approxBeds     Int?
  source         ProspectSource @default(OTHER)
  stage          ProspectStage  @default(NEW)
  assignedToId   String?
  nextFollowUpAt DateTime?
  lostReason     String?
  ownerProfileId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  city         City?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  area         Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assignedTo   User?              @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  ownerProfile OwnerProfile?      @relation(fields: [ownerProfileId], references: [id], onDelete: SetNull)
  activities   ProspectActivity[]

  @@index([stage, nextFollowUpAt])
  @@index([phone])
  @@index([assignedToId])
}

model ProspectActivity {
  id         String               @id @default(cuid())
  prospectId String
  actorId    String?
  type       ProspectActivityType
  body       String?              @db.Text
  metadata   Json?
  createdAt  DateTime             @default(now())

  prospect OwnerProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  actor    User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
}

model AvailabilityReminder {
  id          String    @id @default(cuid())
  propertyId  String
  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
}

model Destination {
  id         String          @id @default(cuid())
  name       String
  slug       String          @unique
  type       DestinationType
  cityId     String?
  latitude   Float
  longitude  Float
  h3Cell     String
  aliases    String[]        @default([])
  popularity Int             @default(0)
  metroLine  String?
  seoEnabled Boolean         @default(false)
  city       City?           @relation(fields: [cityId], references: [id])

  @@index([popularity])
  @@index([h3Cell])
  @@index([type])
  @@index([seoEnabled])
}

model CommuteEdge {
  id          String        @id @default(cuid())
  propertyId  String
  destH3      String
  mode        CommuteMode
  slot        CommuteSlot
  minutes     Int
  km          Float
  oneWayCost  Int
  legs        Json?
  source      CommuteSource
  computedAt  DateTime      @default(now())
  approximate Boolean       @default(false)
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, destH3, mode, slot])
  @@index([destH3, mode, slot])
  @@index([computedAt])
}

model FareRule {
  id             String      @id @default(cuid())
  mode           CommuteMode
  city           String
  effectiveFrom  DateTime
  slabs          Json?
  base           Float?
  perKm          Float?
  perMin         Float?
  peakMultiplier Float       @default(1)
  sourceUrl      String
  estimate       Boolean     @default(false)

  @@index([mode, city, effectiveFrom])
}

model Poi {
  id           String        @id @default(cuid())
  osmOrPlaceId String        @unique
  name         String
  category     PoiCategory
  latitude     Float
  longitude    Float
  rating       Float?
  openLate     Boolean       @default(false)
  source       String        @default("places")
  properties   PropertyPoi[]

  @@index([category])
}

model PropertyPoi {
  propertyId     String
  poiId          String
  walkingMinutes Int
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  poi            Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@id([propertyId, poiId])
}

model UserSearch {
  id           String   @id @default(cuid())
  userId       String?
  name         String?
  destinations Json
  prefs        Json
  arrivalTime  String   @default("09:30")
  maxMin       Int?
  maxCost      Int?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@index([userId])
}

model Alert {
  id           String              @id @default(cuid())
  userId       String
  userSearchId String?
  propertyId   String?
  channel      NotificationChannel @default(IN_APP)
  title        String
  body         String
  readAt       DateTime?
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSearch   UserSearch?         @relation(fields: [userSearchId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model RoommateProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  destH3    String?
  destLabel String?
  bio       String?  @db.Text
  habits    Json
  optIn     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoommateMatch {
  id        String   @id @default(cuid())
  aUserId   String
  bUserId   String
  aAccepted Boolean  @default(false)
  bAccepted Boolean  @default(false)
  createdAt DateTime @default(now())
  aUser     User     @relation("RoommateA", fields: [aUserId], references: [id], onDelete: Cascade)
  bUser     User     @relation("RoommateB", fields: [bUserId], references: [id], onDelete: Cascade)

  @@unique([aUserId, bUserId])
}

/// E-E-A-T profile shown on posts; optionally linked to the admin who writes as them.
model BlogAuthor {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  jobTitle    String?
  bio         String?    @db.Text
  credentials String?
  expertise   String[]   @default([])
  avatarUrl   String?
  sameAs      String[]   @default([])
  userId      String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  posts       BlogPost[] @relation("BlogPostAuthor")
  reviewed    BlogPost[] @relation("BlogPostReviewer")
}

model BlogCategory {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  description     String?    @db.Text
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  posts           BlogPost[]
}

model BlogTag {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  description     String?       @db.Text
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  posts           BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogPost {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  subtitle           String?
  excerpt            String?        @db.Text
  /// Tiptap/ProseMirror JSON document.
  contentJson        Json
  status             BlogStatus     @default(DRAFT)
  publishedAt        DateTime?
  authorId           String?
  reviewerId         String?
  categoryId         String?
  coverImageUrl      String?
  coverAlt           String?
  // Derived from contentJson on every save.
  wordCount          Int            @default(0)
  readingMinutes     Int            @default(0)
  toc                Json           @default("[]")
  plainText          String         @default("") @db.Text
  // SEO
  seoTitle           String?
  metaDescription    String?
  focusKeyword       String?
  secondaryKeywords  String[]       @default([])
  canonicalUrl       String?
  noindex            Boolean        @default(false)
  nofollow           Boolean        @default(false)
  ogTitle            String?
  ogDescription      String?
  ogImageUrl         String?
  twitterTitle       String?
  twitterDescription String?
  schemaType         BlogSchemaType @default(BLOG_POSTING)
  // AEO
  tldr               String?        @db.Text
  keyTakeaways       String[]       @default([])
  faqs               Json           @default("[]")
  howToSteps         Json           @default("[]")
  speakable          Boolean        @default(true)
  // GEO
  aiSummary          String?        @db.Text
  statistics         Json           @default("[]")
  citations          Json           @default("[]")
  entities           Json           @default("[]")
  lastFactCheckedAt  DateTime?
  targetCityId       String?
  targetAreaId       String?
  // Internal links
  relatedPropertyIds String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  author     BlogAuthor?   @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewer   BlogAuthor?   @relation("BlogPostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  targetCity City?         @relation(fields: [targetCityId], references: [id], onDelete: SetNull)
  targetArea Area?         @relation(fields: [targetAreaId], references: [id], onDelete: SetNull)
  tags       BlogPostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}
